index=main sourcetype="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=13
  TargetObject="*\\CurrentControlSet\\Services\\*\\ImagePath"
  (Details="*cmd.exe*" OR Details="*powershell*" OR Details="*-w hidden*"
   OR Details="*-nop*" OR Details="*-enc*"
   OR Details="*\\temp\\*" OR Details="*%temp%*")
| table _time, Computer, User, Image, TargetObject, Details
| sort -_time
